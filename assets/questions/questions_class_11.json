      "id": "class_11_03",
      "audience": "CLASS_11",
      "question": "What is the derivative of f(x) = x³ - 4x + 7 with respect to x?",
      "description": null,
      "options": [
        {
          "id": "A",
          "text": "3x² - 4"
        },
        {
          "id": "B",
          "text": "3x² + 7"
        },
        {
          "id": "C",
          "text": "x² - 4"
        },
        {
          "id": "D",
          "text": "3x³ - 4"
        }
      ],
      "correctAnswerId": "A",
      "explanation": "d/dx (x³) = 3x², d/dx (-4x) = -4, and d/dx (7) = 0. Result: 3x² - 4.",
      "difficulty": "medium",
      "topic": "calculus_derivatives",
      "active": true,
      "version": "1.0"
    },
