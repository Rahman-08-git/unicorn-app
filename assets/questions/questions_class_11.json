      "id": "class_11_01",
      "audience": "CLASS_11",
      "question": "Two vectors of magnitude 3 N and 4 N act at a right angle (90°) to each other. What is their resultant magnitude?",
      "description": null,
      "options": [
        {
          "id": "A",
          "text": "5 N"
        },
        {
          "id": "B",
          "text": "7 N"
        },
        {
          "id": "C",
          "text": "1 N"
        },
        {
          "id": "D",
          "text": "12 N"
        }
      ],
      "correctAnswerId": "A",
      "explanation": "Resultant = √(3² + 4²) = √(9 + 16) = √25 = 5 N.",
      "difficulty": "medium",
      "topic": "vector_kinematics",
      "active": true,
      "version": "1.0"
    },
